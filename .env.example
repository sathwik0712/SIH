# BHOOMISETU — Environment Variables Template
# Copy this file to .env and fill in values for your environment.
# DO NOT commit the .env file to Git.

# Backend API Gateway Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Dev demo fallback password displayed on login screen
VITE_CITIZEN_DEMO_PASS=demo

# Demo token seed used in local mock mode (replaces hardcoded token literals)
VITE_DEMO_TOKEN_SEED=dev

# Supabase Cloud Storage (Statutory Document Repository)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_STORAGE_BUCKET=statutory-documents
